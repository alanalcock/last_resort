{
  "name": "payroll-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    }
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "prisma generate && next build --webpack",
    "start": "next start",
    "lint": "eslint . --cache --cache-location .next/cache/eslint/",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit --pretty false",
    "clean": "node -e \"const fs=require('fs'); for (const dir of ['.next','out','dist','build','coverage']) fs.rmSync(dir,{recursive:true,force:true});\""
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@supabase/supabase-js": "^2.117.3",
    "dotenv": "^18.0.8",
    "jose": "^6.2.12",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.57.0",
    "next": "16.4.0",
    "papaparse": "^5.7.0",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.0",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}
