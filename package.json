{
  "name": "payroll-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "prisma generate && next build --webpack",
    "start": "next start",
    "lint": "eslint . --cache --cache-location .next/cache/eslint/",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit --pretty false",
    "clean": "node -e \"const fs=require('fs'); for (const dir of ['.next','out','dist','build','coverage']) fs.rmSync(dir,{recursive:true,force:true});\""
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "@supabase/supabase-js": "^2.105.4",
    "dotenv": "^17.4.2",
    "jose": "^6.2.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.14.0",
    "next": "16.2.6",
    "papaparse": "^5.5.3",
    "pg": "^8.21.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "prisma": "^6.4.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
